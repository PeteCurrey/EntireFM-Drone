# ==============================================================================
# EntireFM Drone — Environment Configuration Example
# Canonical Domain: https://drone.entirefm.com
# Repository: https://github.com/PeteCurrey/EntireFM-Drone.git
# ==============================================================================

# Site URL
NEXT_PUBLIC_SITE_URL=https://drone.entirefm.com
NEXT_PUBLIC_APP_URL=https://drone.entirefm.com

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Email / Notifications (Resend)
RESEND_API_KEY=your-resend-key-here
RESEND_FROM_EMAIL=EntireFM Drone <onboarding@resend.dev>
ADMIN_EMAIL=drone@entirefm.com

# Analytics Configuration
NEXT_PUBLIC_ANALYTICS_ENABLED=true
